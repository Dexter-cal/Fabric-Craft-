[gd_scene format=3 uid="uid://toolbar_scene"]

[node name="Toolbar" type="HBoxContainer"]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 40.0
grow_horizontal = 2

# --- Main Toolbar for Tools ---
# This will contain buttons for Select, Draw, Cut, Stitch, etc.

[node name="SelectButton" type="Button" parent="."]
layout_mode = 2
text = "Select"

[node name="DrawButton" type="Button" parent="."]
layout_mode = 2
toggle_mode = true
text = "Draw"

[node name="CutButton" type="Button" parent="."]
layout_mode = 2
text = "Cut"

[node name="AISuggestButton" type="Button" parent="."]
layout_mode = 2
text = "AI Suggest"
